{
  "name": "ent",
  "version-string": "0.1.0",
  "builtin-baseline": "d68a18f57975d5fc80fc33a24c176bfc0801b344",
  "description": "Cross-platform C infrastructure library",
  "default-features": [
    "sqlite",
    "mysql",
    "pgsql"
  ],
  "features": {
    "sqlite": {
      "description": "Enable the SQLite backend",
      "dependencies": [
        "sqlite3"
      ]
    },
    "mysql": {
      "description": "Enable the MySQL/MariaDB backend",
      "dependencies": [
        "libmariadb"
      ]
    },
    "pgsql": {
      "description": "Enable the PostgreSQL backend",
      "dependencies": [
        "libpq"
      ]
    }
  }
}
