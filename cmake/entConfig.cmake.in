@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@ENT_ENABLE_SQLITE@)
  find_dependency(SQLite3)
endif()

if(@ENT_ENABLE_MYSQL@)
  list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  find_dependency(MariaDB MODULE)
  list(POP_FRONT CMAKE_MODULE_PATH)
endif()

if(@ENT_ENABLE_PGSQL@)
  find_dependency(PostgreSQL)
endif()

if(@ENT_ENABLE_LUA@ AND "@ENT_LUA_LINK_MODE@" STREQUAL "shared")
  list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  find_dependency(EntLua MODULE)
  list(POP_FRONT CMAKE_MODULE_PATH)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/EntMsgCodegen.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/entTargets.cmake")

check_required_components(ent)
